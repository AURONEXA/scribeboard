{
  "name": "scribeboard-api",
  "version": "1.0.0",
  "description": "ScribeBoard API - Complete Blog CMS Backend Service with author roles, publishing workflows, and comment moderation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "mutation": "stryker run",
    "fuzz": "jazzer fuzz/auth.fuzz.js --timeout 10000",
    "load-test": "k6 run load-test.js",
    "security-audit": "npm audit --audit-level=high",
    "prisma:validate": "npx prisma validate"
  },
  "keywords": [
    "blog",
    "cms",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/javascript-mutator": "^4.0.0",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^4.0.0",
    "jazzer": "^0.0.5",
    "jest": "^30.3.0",
    "k6": "^0.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.3",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
